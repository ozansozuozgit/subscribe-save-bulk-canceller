{
  "manifest_version": 3,
  "name": "Subscription Bulk Canceller",
  "version": "2.1.2",
  "description": "See your Amazon Subscribe & Save subscriptions in one list and cancel the ones you pick. Runs locally. Not affiliated with Amazon.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Subscription Bulk Canceller",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/gp/subscribe-and-save/manager/viewsubscriptions*",
        "https://www.amazon.com/auto-deliveries/subscriptionList*",
        "https://www.amazon.com/auto-deliveries*"
      ],
      "js": [
        "utils.js",
        "selectors.js",
        "scan.js",
        "content_manager.js"
      ],
      "css": [
        "ui/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/auto-deliveries*",
        "https://www.amazon.com/gp/subscribe-and-save/*"
      ],
      "js": [
        "utils.js",
        "selectors.js",
        "content_cancel.js"
      ],
      "css": [
        "ui/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/auto-deliveries*",
        "https://www.amazon.com/gp/subscribe-and-save/*"
      ],
      "js": [
        "content_progress.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
